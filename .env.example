# ---- Core ----
DATABASE_URL=postgresql://appforge:appforge@localhost:5432/appforge
# Public URL of the web app (used in emails and as API base inside generated apps)
APP_URL=http://localhost:3000
# 32+ random chars. Used to encrypt Android keystore passwords. NEVER change after first build.
ENCRYPTION_KEY=change-me-to-a-long-random-string-please-32+
# Where uploads and build artifacts are stored (local driver). Relative paths resolve from apps/web and apps/builder.
STORAGE_DIR=../../storage

# ---- Email (optional; without it emails are printed to the server log) ----
SMTP_URL=
MAIL_FROM="Forjapp <no-reply@forjapp.local>"

# ---- AI assistant (optional). Users can also connect their own Claude/ChatGPT/Gemini key in their profile. ----
# Platform key, used for users without their own AI connection and counted against plan quotas.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Stripe (optional; billing stays disabled until set) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Builder service ----
ANDROID_HOME=/opt/android-sdk
GRADLE_BIN=gradle
BUILDER_CONCURRENCY=1
BUILD_TIMEOUT_MINUTES=20

# Admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@forjapp.local
SEED_ADMIN_PASSWORD=Admin12345!
